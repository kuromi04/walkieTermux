#!/data/data/com.termux/files/usr/bin/bash
# walkie-rotate-secret — Rota el secreto del canal P2P de WalkieTermux.
#
# El secreto (canal:secreto) se hashea para formar el topic P2P. Rotarlo
# invalida el secreto antiguo (que quedó en el historial de git público) y
# evita que terceros se unan a tu canal.
#
# Uso:
#   walkie-rotate-secret                  # dry-run: genera secreto y muestra el plan
#   walkie-rotate-secret --apply          # aplica la rotación (con backup previo)
#   walkie-rotate-secret --apply --restart# aplica y reinicia los puentes activos
#
# Actualiza:
#   1. config/agents.json            -> campo "channel" (canal:secreto)
#   2. ~/.config/walkie-tg/config.json -> campo "secret" (puente Telegram)
# Y (con --restart) reinicia el puente WhatsApp y el servicio walkie-tg.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AGENTS_JSON="$REPO_DIR/config/agents.json"
TG_CONFIG="${WALKIE_TG_CONFIG:-$HOME/.config/walkie-tg/config.json}"

APPLY=0
RESTART=0

usage() {
  sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

for a in "$@"; do
  case "$a" in
    --apply|-y|--yes) APPLY=1 ;;
    --restart)        RESTART=1 ;;
    -h|--help)        usage; exit 0 ;;
    *) echo "✗ Opción desconocida: $a"; usage; exit 1 ;;
  esac
done

# --- Dependencias ---
for dep in jq openssl; do
  command -v "$dep" >/dev/null 2>&1 || { echo "✗ Falta '$dep' (pkg install jq openssl-tool)"; exit 1; }
done

# --- Leer estado actual ---
[ -f "$AGENTS_JSON" ] || { echo "✗ No existe $AGENTS_JSON"; exit 1; }

CHANNEL_FIELD="$(jq -r '.channel' "$AGENTS_JSON")"
CHANNEL_NAME="${CHANNEL_FIELD%%:*}"
OLD_SECRET="${CHANNEL_FIELD#*:}"

if [ -z "$CHANNEL_NAME" ] || [ "$CHANNEL_NAME" = "$OLD_SECRET" ]; then
  echo "✗ El campo 'channel' no tiene formato 'canal:secreto' (actual: '$CHANNEL_FIELD')"
  exit 1
fi

# --- Generar nuevo secreto (192 bits) ---
NEW_SECRET="$(openssl rand -hex 24)"

# --- Mostrar plan ---
echo "═══════════════════════════════════════════════════"
echo "  Rotación del secreto P2P — walkieTermux"
echo "═══════════════════════════════════════════════════"
echo "  Canal        : $CHANNEL_NAME"
echo "  Secreto viejo: ${OLD_SECRET:0:6}… (${#OLD_SECRET} chars)"
echo "  Secreto nuevo: ${NEW_SECRET:0:6}…${NEW_SECRET: -6} (${#NEW_SECRET} chars)"
echo
echo "  Archivos a actualizar:"
echo "    1. $AGENTS_JSON"
if [ -f "$TG_CONFIG" ]; then
  echo "    2. $TG_CONFIG"
else
  echo "    (no hay $TG_CONFIG; puente Telegram usa env vars)"
fi
echo

if [ "$APPLY" -ne 1 ]; then
  echo "  (dry-run) No se modificó nada. Usa --apply para aplicar."
  exit 0
fi

# --- Backup con timestamp ---
TS="$(date +%Y%m%d-%H%M%S)"
cp -p "$AGENTS_JSON" "$AGENTS_JSON.bak-$TS"
[ -f "$TG_CONFIG" ] && cp -p "$TG_CONFIG" "$TG_CONFIG.bak-$TS"

# --- Aplicar cambios (atómico: tmp + mv) ---
jq --arg c "$CHANNEL_NAME:$NEW_SECRET" '.channel = $c' "$AGENTS_JSON" > "$AGENTS_JSON.tmp" \
  && mv "$AGENTS_JSON.tmp" "$AGENTS_JSON"

if [ -f "$TG_CONFIG" ]; then
  jq --arg s "$NEW_SECRET" '.secret = $s' "$TG_CONFIG" > "$TG_CONFIG.tmp" \
    && mv "$TG_CONFIG.tmp" "$TG_CONFIG"
  chmod 600 "$TG_CONFIG"
fi

echo "✓ Configuración actualizada (backups: *.bak-$TS)"
echo

# --- Reiniciar puentes si se pidió ---
if [ "$RESTART" -eq 1 ]; then
  echo "Reiniciando puentes..."

  # Puente WhatsApp (proceso manual)
  if pkill -f "bin/walkie-whatsapp.js" 2>/dev/null; then
    echo "  - Puente WhatsApp detenido"
  else
    echo "  - Puente WhatsApp no estaba activo"
  fi

  # Puente Telegram (servicio runsv)
  if command -v sv >/dev/null 2>&1 && sv status walkie-tg >/dev/null 2>&1; then
    sv restart walkie-tg >/dev/null 2>&1 && echo "  - Puente Telegram reiniciado" \
      || echo "  - Puente Telegram: no se pudo reiniciar"
  else
    echo "  - Puente Telegram: servicio no detectado"
  fi

  # Relanzar WhatsApp bridge con el nuevo secreto (desacoplado por completo)
  ( cd "$REPO_DIR" && exec node bin/walkie-whatsapp.js "$CHANNEL_NAME:$NEW_SECRET" \
      >"$HOME/.walkie-whatsapp.log" 2>&1 ) </dev/null &
  disown 2>/dev/null || true
  echo "  - Puente WhatsApp relanzado con el nuevo secreto"
else
  echo "Reinicio pendiente (usa --restart o hazlo manual):"
  echo "  node bin/walkie-whatsapp.js '$CHANNEL_NAME:$NEW_SECRET'"
  echo "  sv restart walkie-tg"
fi

echo
echo "⚠  El secreto antiguo sigue en el historial de git público (no se puede borrar)."
echo "   Rotarlo aquí invalida su uso, pero revisa también:"
echo "   - presentacion-walkieTermux/* (docs locales que citan el secreto viejo)"
echo "   - tokens de bot Telegram/WhatsApp si consideras que pudieron quedar expuestos"
